# clang-tidy configuration.
# Disabled on purpose: bugprone-branch-clone (branches that differ only by log macros that compile
# out, and constexpr factory ladders), bugprone-forwarding-reference-overload and
# cppcoreguidelines-missing-std-forward (InputData(T&&) and the callback templates take forwarding
# references intentionally). performance-inefficient-string-concatenation is off because it only
# fires in log-message construction.
# Do not put comments inside the Checks block: it is a YAML string.
# Run with: ./scripts/compile.sh --tidy
# Checks focus on likely bugs and avoidable cost; style is left to clang-format.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-reserved-identifier,
  -bugprone-branch-clone,
  -bugprone-forwarding-reference-overload,
  -cppcoreguidelines-missing-std-forward,
  performance-*,
  -performance-enum-size,
  -performance-no-int-to-ptr,
  -performance-inefficient-string-concatenation,
  misc-redundant-expression,
  misc-unused-using-decls,
  misc-unused-alias-decls,
  modernize-use-nodiscard,
  modernize-use-override,
  modernize-use-noexcept,
  modernize-use-emplace,
  readability-container-size-empty,
  readability-redundant-control-flow,
  readability-redundant-smartptr-get,
  readability-redundant-string-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-rvalue-reference-param-not-moved
WarningsAsErrors: ''
HeaderFilterRegex: '.*/src/pathspace/.*'
FormatStyle: file
